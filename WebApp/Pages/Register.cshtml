@page
@model WebApp.Pages.RegisterModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Mi App</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-container">
        <!-- Formulario de Registro -->
        <div class="register-form">
            <div class="form-header">
                <h2><i class="fas fa-user-plus"></i> Crear Cuenta</h2>
                <p>Únete a nosotros</p>
            </div>
            
            <form id="registerForm">
                <div class="input-group">
                    <i class="fas fa-id-card"></i>
                    <input type="number" id="cedula" name="cedula" placeholder="Cédula" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" id="nombre" name="nombre" placeholder="Nombre" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" id="apellido" name="apellido" placeholder="Apellido" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-envelope"></i>
                    <input type="email" id="correo" name="correo" placeholder="Correo electrónico" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="contrasena" name="contrasena" placeholder="Contraseña" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-phone"></i>
                    <input type="number" id="telefono" name="telefono" placeholder="Teléfono">
                </div>
                
                <button type="submit" class="btn-primary">
                    <i class="fas fa-check"></i> Registrarse
                </button>
            </form>
            
            <div class="switch-form">
                <p>¿Ya tienes cuenta?</p>
                <a href="/Login"><i class="fas fa-sign-in-alt"></i> Iniciar sesión</a>
            </div>
        </div>
    </div>

    <script src="~/js/pages/RegisterViewController.js"></script>
</body>
</html>
