@page
@model WebApp.Pages.RegistroPropiedadesModel


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Propiedades</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="css/RegistroPropiedad.css">

</head>
<body>

    

    <div class="container mt-4 mb-5">
        <h2 class="mb-4">Registro de Propiedades</h2>

        <form method="post" id="formRegistroPropiedad">

            <div class="mb-3">
                <label for="nombreFinca" class="form-label">Nombre de la finca</label>
                <input type="text" class="form-control form-control-lg" id="nombreFinca">
                <div class="text-danger small" id="errorNombreFinca"></div>
            </div>

            <div class="mb-3">
                <label for="ubicacion" class="form-label">Ubicación</label>
                <input type="text" class="form-control" id="ubicacion" name="Ubicacion">
                <div class="text-danger small" id="errorUbicacion"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Seleccione la ubicación en el mapa</label>

                <div id="map" style="height: 400px; border-radius: 10px;"></div>

                <input type="hidden" id="latitud" name="Latitud">
                <input type="hidden" id="longitud" name="Longitud">

                <div class="text-danger small" id="errorMapa"></div>
            </div>


            <div class="mb-3">
                <label for="fotografias" class="form-label">Fotografías</label>
                <input type="file" class="form-control" id="fotografias" name="Fotografias" multiple accept="image/*">

                <div class="text-danger small" id="errorImagenes"></div>

                <!-- PREVIEW -->
                <div id="previewImagenes" class="mt-3 d-flex flex-wrap gap-2"></div>
            </div>

            <hr />

            <h4 class="mb-3">Características Ambientales</h4>

            <div class="mb-3">
                <label for="tamano" class="form-label">Tamaño (hectáreas)</label>
                <input type="number" class="form-control" id="tamano" name="Tamano" step="0.01">
                <div class="text-danger small" id="errorTamano"></div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Tipo de superficie</label>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Superficie" id="superficiePlana" value="Plana">
                    <label class="form-check-label" for="superficiePlana">Plana</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Superficie" id="superficieInclinada" value="Inclinada">
                    <label class="form-check-label" for="superficieInclinada">Inclinada</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Superficie" id="superficieMuyInclinada" value="Muy inclinada">
                    <label class="form-check-label" for="superficieMuyInclinada">Muy inclinada</label>
                </div>

                <div class="text-danger small" id="errorSuperficie"></div>
            </div>

            <div class="mb-3">
                <label for="rios" class="form-label">¿Contiene ríos o quebradas?</label>
                <select class="form-select" id="rios" name="Rios">
                    <option value="">Seleccione una opción</option>
                    <option value="Si">Sí</option>
                    <option value="No">No</option>
                </select>
                <div class="text-danger small" id="errorRios"></div>
            </div>

            <div class="mb-3">
                <label for="nacientes" class="form-label">¿Posee nacientes?</label>
                <select class="form-select" id="nacientes" name="Nacientes">
                    <option value="">Seleccione una opción</option>
                    <option value="Si">Sí</option>
                    <option value="No">No</option>
                </select>
                <div class="text-danger small" id="errorNacientes"></div>
            </div>

            <div class="mb-3">
                <label for="cantidadNacientes" class="form-label">Cantidad de nacientes</label>
                <input type="number" class="form-control" id="cantidadNacientes" name="CantidadNacientes">
                <div class="text-danger small" id="errorCantidadNacientes"></div>
            </div>

            <div class="mb-3">
                <label for="vegetacion" class="form-label">Tipo de Vegetación</label>
                <select class="form-select" id="vegetacion" name="Vegetacion">
                    <option value="">Seleccione una opción</option>
                    <option value="Bosque primario">Bosque primario</option>
                    <option value="Bosque secundario">Bosque secundario</option>
                    <option value="Plantación forestal">Plantación forestal</option>
                    <option value="Pasto">Pasto</option>
                </select>
                <div class="text-danger small" id="errorVegetacion"></div>
            </div>

            <div class="mb-4">
                <label for="usoSuelo" class="form-label">Uso de Suelo</label>
                <select class="form-select" id="usoSuelo" name="UsoSuelo">
                    <option value="">Seleccione una opción</option>
                    <option value="Conservación">Conservación</option>
                    <option value="Producción forestal">Producción forestal</option>
                    <option value="Agroforestal">Agroforestal</option>
                    <option value="Ganadería">Ganadería</option>
                    <option value="Mixto">Mixto</option>
                </select>
                <div class="text-danger small" id="errorUsoSuelo"></div>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold py-2">
                Guardar Propiedad
            </button>
        </form>
    </div>

    <footer class="bg-dark text-white text-center p-4 mt-5">
        <div class="container">
            <p class="mb-1">Sistema de Gestión de Fincas</p>
            <small>© 2026 - Todos los derechos reservados</small>
        </div>
    </footer>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Su JS -->
    <script src="~/js/pages/registropropiedades.js"></script>

</body>
</html>


@{
}
