@page
@model WebApp.Pages.RegistroPropiedadesModel


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro de Propiedades</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- HEADER -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">Registro de Propiedades</span>
        </div>
    </nav>

    <!-- CONTENIDO -->
    <div class="container mt-4">

        <h2>Registro de Propiedades</h2>

        <form method="post">

            <!-- DATOS GENERALES -->
            <div class="mb-3">
                <label class="form-label">Nombre de la finca</label>
                <input type="text" class="form-control" name="NombreFinca">
            </div>

            <div class="mb-3">
                <label class="form-label">Ubicación</label>
                <input type="text" class="form-control" name="Ubicacion">
            </div>

            <div class="mb-3">
                <label class="form-label">Fotografías</label>
                <input type="file" class="form-control">
            </div>

            <hr />

            <!-- CARACTERISTICAS -->
            <h4>Características Ambientales</h4>

            <div class="mb-3">
                <label>Tamaño (hectáreas)</label>
                <input type="number" class="form-control" name="Tamano">
            </div>

            <!-- SUPERFICIE -->
            <label>Tipo de superficie</label>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="Superficie" value="Plana">
                <label class="form-check-label">Plana</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="Superficie" value="Inclinada">
                <label class="form-check-label">Inclinada</label>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="Superficie" value="Muy inclinada">
                <label class="form-check-label">Muy inclinada</label>
            </div>

            <!-- RIOS -->
            <label>¿Contiene ríos o quebradas?</label>
            <select class="form-select mb-3" name="Rios">
                <option>Si</option>
                <option>No</option>
            </select>

            <label>¿Posee nacientes?</label>
            <select class="form-select mb-3" name="Nacientes">
                <option>Si</option>
                <option>No</option>
            </select>

            <div class="mb-3">
                <label>Cantidad de nacientes</label>
                <input type="number" class="form-control" name="CantidadNacientes">
            </div>

            <!-- VEGETACION -->
            <label>Tipo de Vegetación</label>
            <select class="form-select mb-3" name="Vegetacion">
                <option>Bosque primario</option>
                <option>Bosque secundario</option>
                <option>Plantación forestal</option>
                <option>Pasto</option>
            </select>

            <!-- USO DE SUELO -->
            <label>Uso de Suelo</label>
            <select class="form-select mb-3" name="UsoSuelo">
                <option>Conservación</option>
                <option>Producción forestal</option>
                <option>Agroforestal</option>
                <option>Ganadería</option>
                <option>Mixto</option>
            </select>

            <button type="submit" class="btn btn-primary">Guardar</button>

        </form>

    </div>

    <!-- FOOTER -->
    <footer class="bg-dark text-white text-center p-3 mt-5">
        Sistema de Registro de Fincas © 2026
    </footer>

</body>
</html>


@{
}
