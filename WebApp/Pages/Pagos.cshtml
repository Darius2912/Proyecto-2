@model WebApp.Models.PagosViewModel

@{
    ViewData["Title"] = "Pagos";
}

<div class="container mt-4">

    <h2 class="mb-4">Gestión de Pagos</h2>

    <!-- MENSAJES -->
    <div asp-validation-summary="All" class="text-danger"></div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-warning">
            @Model.Mensaje
        </div>
    }

    <!-- FORM -->
    <form method="post" asp-action="Pagos" asp-controller="Home">

        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                Consultar Pago
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <!-- PROPIEDAD -->
                    <div class="col-md-3">
                        <label>Propiedad</label>
                        <select asp-for="PropiedadSeleccionada" class="form-control">
                            <option value="Finca Los Pinos">Finca Los Pinos</option>
                            <option value="Finca La Esperanza">Finca La Esperanza</option>
                        </select>
                    </div>

                    <!-- MES DINÁMICO -->
                    <div class="col-md-3">
                        <label>Mes</label>
                        <select asp-for="MesSeleccionado" class="form-control">
                            @foreach (var mes in System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames)
                            {
                                if (!string.IsNullOrEmpty(mes))
                                {
                                    <option value="@mes" selected="@(mes == DateTime.Now.ToString("MMMM"))">
                                        @mes
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- AÑO DINÁMICO -->
                    <div class="col-md-2">
                        <label>Año</label>
                        <select asp-for="AnioSeleccionado" class="form-control">
                            @for (int i = 2000; i <= DateTime.Now.Year + 5; i++)
                            {
                                <option value="@i" selected="@(i == DateTime.Now.Year)">
                                    @i
                                </option>
                            }
                        </select>
                    </div>

                    <!-- PAGO BASE -->
                    <div class="col-md-2">
                        <label>Pago Base</label>
                        <input asp-for="PagoBase" type="number" min="1" class="form-control" />
                    </div>

                    <!-- VEGETACIÓN -->
                    <div class="col-md-2">
                        <label>Vegetación</label>
                        <select asp-for="Vegetacion" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                            <option value="20">20%</option>
                        </select>
                    </div>

                    <!-- HIDRICOS -->
                    <div class="col-md-2">
                        <label>Recursos Hídricos</label>
                        <select asp-for="RecursosHidricos" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                    <!-- PENDIENTE -->
                    <div class="col-md-2">
                        <label>Pendiente</label>
                        <select asp-for="Pendiente" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-success">Consultar</button>
                </div>

            </div>
        </div>

    </form>

    <!-- MENSAJE DE ÉXITO -->
    @if (Model.TotalPago > 0)
    {
        <div class="alert alert-success">
            Pago calculado correctamente
        </div>
    }

    <!-- DETALLE -->
    @if (Model.PagoDetalle != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                Detalle del Pago
            </div>

            <div class="card-body">

                <p><strong>Propiedad:</strong> @Model.PagoDetalle.Propiedad</p>
                <p><strong>Periodo:</strong> @Model.PagoDetalle.Periodo</p>

                <ul>
                    <li>Pago base: ₡@Model.PagoBase.ToString("N0")</li>
                    <li>Vegetación: @Model.Vegetacion %</li>
                    <li>Hídricos: @Model.RecursosHidricos %</li>
                    <li>Pendiente: @Model.Pendiente %</li>
                </ul>

                <h4 class="text-success">
                    Monto: ₡@Model.TotalPago.ToString("N0")
                </h4>

                <span class="badge @(Model.PagoDetalle.Estado == "Pagado" ? "bg-success" : "bg-warning text-dark")">
                    @Model.PagoDetalle.Estado
                </span>

            </div>
        </div>
    }

    <!-- HISTORIAL -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            Historial de Pagos
        </div>

        <div class="card-body">

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Propiedad</th>
                        <th>Periodo</th>
                        <th>Monto</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.HistorialFiltrado)
                    {
                        <tr>
                            <td>@item.Propiedad</td>
                            <td>@item.Periodo</td>
                            <td>₡@item.Monto.ToString("N0")</td>
                            <td>
                                <span class="badge @(item.Estado == "Pagado" ? "bg-success" : "bg-warning text-dark")">
                                    @item.Estado
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

    <!-- PLAN DE PAGOS -->
    @if (Model.PlanPagos != null && Model.PlanPagos.Any())
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                Plan de Pagos Simulado (6 meses)
            </div>

            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Monto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PlanPagos)
                        {
                            <tr>
                                <td>@item.Periodo</td>
                                <td>₡@item.Monto.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

</div>