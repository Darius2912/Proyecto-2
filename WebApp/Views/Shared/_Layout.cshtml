@* _Layout.cshtml *@
@using Microsoft.AspNetCore.Mvc.Razor
@{
    // Título por defecto
    var pageTitle = ViewData["Title"] ?? "WebApp";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - WebApp</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />

    

    @RenderSection("Head", required: false)
</head>
<body>
    <header>
        <!-- LÍNEA VERDE SUPERIOR -->
        <div class="header-top-line"></div>

        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm header-terra">
            <div class="container-fluid px-4">
                <!-- LOGO -->
                <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                    <span class="fw-bold text-white">PSA</span>
                </a>

                <!-- BOTÓN MÓVIL -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENÚ -->
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active fw-bold" : "")"
                               asp-controller="Home" asp-action="Index">
                                Inicio
                            </a>
                        </li>
                       
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "RegistroPropiedades" ? "active fw-bold" : "")"
                               asp-controller="Home" asp-action="RegistroPropiedades">
                                Registrar Propiedad
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "MisPropiedades" ? "active fw-bold" : "")"
                               asp-controller="Home" asp-action="MisPropiedades">
                                Mis Propiedades
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Pagos" ? "active fw-bold" : "")"
                               asp-controller="Home" asp-action="Pagos">
                                Pagos
                            </a>
                        </li>

                        <li class="nav-item">
                            @if (ViewBag.Rol == 3) // Ingeniero
                            {
                                <a class="nav-link @(currentAction == "Reportes" ? "active fw-bold" : "")"
                                       asp-controller="Home" asp-action="ReportesIngeniero">
                                    Reportes
                                </a>
                            }
                            else if (ViewBag.Rol == 2) // Administrador
                            {
                                <a class="nav-link @(currentAction == "ReportesAdmin" ? "active fw-bold" : "")"
                                       asp-controller="Home" asp-action="ReportesAdmin">
                                    Reportes
                                </a>
                            }
                        

                        @if (ViewBag.Rol == 2)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Dashboard" ? "active fw-bold" : "")"
                                   asp-controller="Home" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                        }
                        

                    </ul>

                    <!-- USUARIO -->
                    <div class="d-flex gap-2">

                        @if (ViewBag.Rol == null)

                            {
                            <a class="btn btn-outline-light btn-sm"
                               asp-controller="Acceso"
                               asp-action="Login">
                                Login
                            </a>

                            <a class="btn btn-light btn-sm fw-bold text-success"
                               asp-controller="Acceso"
                               asp-action="Register">
                                Registrarse
                            </a>
                            }

                        @if (ViewBag.Rol != null)
                            {
                            <a class="btn btn-outline-light btn-sm"
                               asp-controller="Acceso"
                               asp-action="Logout">
                                Cerrar Sesion
                            </a>  
                            }



                        
                    </div>


                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO -->
    <div class="container mt-4">
        <main role="main" class="flex-fill">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer-terra mt-5">
        <div class="footer-top-line"></div>
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-md-4 text-md-start text-center mb-2 mb-md-0">
                    <strong>PSA</strong><br />
                    <small>Pagos por Servicios Ambientales</small>
                </div>
                <div class="col-md-4 text-center mb-2 mb-md-0">
                    <small>© @DateTime.Now.Year - Todos los derechos reservados</small>
                </div>
                <div class="col-md-4 text-md-end text-center">
                    <a href="#" class="footer-link">Soporte</a> |
                    <a href="#" class="footer-link">Privacidad</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>