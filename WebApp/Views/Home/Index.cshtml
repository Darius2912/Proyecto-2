@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<header class="masthead text-white text-center d-flex align-items-center"
        style="background-image: url('@Url.Content("~/assets/img/Portada.png")');
               background-size: cover;
               background-position: center;
               min-height:100vh;">

    <div class="container scroll-anim">
        <img src="@Url.Content("~/assets/img/logo.jpeg")"
             class="img-fluid"
             style="max-height:120px; margin-bottom:20px;" />

        <h1 class="mb-3">Nexus Software</h1>

        <p class="mb-4">
            Transformamos ideas en soluciones tecnológicas innovadoras
        </p>

        <a asp-page="/Landing2" class="btn btn-primary btn-lg">
            Ver nuestro sistema
        </a>
    </div>
</header>

<!-- QUIÉNES SOMOS -->
<section class="section-blue text-center p-5 scroll-anim">
    <h2><i data-lucide="briefcase"></i> ¿Quiénes somos?</h2>
    <p>
        En Nexus Software creemos en la innovación constante, el desarrollo de soluciones
        eficientes y la creación de herramientas tecnológicas que realmente generen impacto
        en las organizaciones.
    </p>
</section>

<!-- RESULTADOS -->
<section class="section-purple p-5 scroll-anim">
    <h2 class="text-center"><i data-lucide="bar-chart-3"></i> Resultados</h2>

    <ul class="results-list">
        <li><span class="counter" data-target="50">0</span> proyectos desarrollados</li>
        <li><span class="counter" data-target="35">0</span> clientes satisfechos</li>
        <li><span class="counter" data-target="100">0</span> procesos optimizados</li>
    </ul>
</section>

<!-- SERVICIOS -->
<section class="section-light text-center p-5 scroll-anim">
    <h2><i data-lucide="settings"></i> ¿Qué hacemos?</h2>

    <div class="grid-cards">
        <div class="card-pro">
            <img src="@Url.Content("~/assets/img/programming.jpg")" class="card-bg">
            <div class="overlay blue"></div>
            <div class="card-content">
                <h4><i data-lucide="globe"></i> Desarrollo Web</h4>
                <p>Aplicaciones modernas y seguras.</p>
            </div>
        </div>

        <div class="card-pro">
            <img src="@Url.Content("~/assets/img/data.jpg")" class="card-bg">
            <div class="overlay purple"></div>
            <div class="card-content">
                <h4><i data-lucide="building"></i> Sistemas Empresariales</h4>
                <p>Automatización de procesos.</p>
            </div>
        </div>

        <div class="card-pro">
            <img src="@Url.Content("~/assets/img/dashboard.jpg")" class="card-bg">
            <div class="overlay dark"></div>
            <div class="card-content">
                <h4><i data-lucide="database"></i> Gestión de Datos</h4>
                <p>Análisis y optimización.</p>
            </div>
        </div>
    </div>
</section>

<!-- CASOS -->
<section class="section-mix p-5 scroll-anim">
    <h2 class="text-center"><i data-lucide="bar-chart-2"></i> Casos de éxito</h2>

    <div class="cases-container">

        <div class="case-card blue">
            <div class="case-header">
                <span><i data-lucide="briefcase"></i> Optimización Empresarial</span>
                <span class="arrow">▼</span>
            </div>
            <div class="case-body">
                Reducción del 35% en costos operativos mediante automatización de procesos.
            </div>
        </div>

        <div class="case-card purple">
            <div class="case-header">
                <span><i data-lucide="trending-up"></i> Transformación Digital</span>
                <span class="arrow">▼</span>
            </div>
            <div class="case-body">
                Migración completa a la nube con 99.9% de disponibilidad y tiempos de respuesta 60% más rápidos.
            </div>
        </div>

        <div class="case-card dark">
            <div class="case-header">
                <span><i data-lucide="shield-check"></i> Seguridad y Cumplimiento</span>
                <span class="arrow">▼</span>
            </div>
            <div class="case-body">
                Implementación de auditoría en tiempo real, logrando certificación ISO 27001 en menos de 6 meses.
            </div>
        </div>

    </div>
</section>

<!-- EQUIPO -->
<section class="section-light text-center p-5 scroll-anim">
    <h2><i data-lucide="users"></i> Nuestro equipo</h2>

    <div class="team-grid">
        <div class="team-member">
            <div class="img-wrapper">
                <img src="@Url.Content("~/assets/img/team1.jpg")" class="team-img" alt="CEO" />
                <div class="team-overlay"><span>CEO</span></div>
            </div>
            <h5 class="mt-3">Ana García</h5>
            <p class="text-muted">CEO &amp; Fundadora</p>
        </div>

        <div class="team-member">
            <div class="img-wrapper">
                <img src="@Url.Content("~/assets/img/team2.jpg")" class="team-img" alt="CTO" />
                <div class="team-overlay"><span>CTO</span></div>
            </div>
            <h5 class="mt-3">Carlos Méndez</h5>
            <p class="text-muted">CTO</p>
        </div>

        <div class="team-member">
            <div class="img-wrapper">
                <img src="@Url.Content("~/assets/img/team3.jpg")" class="team-img" alt="Dev" />
                <div class="team-overlay"><span>Dev</span></div>
            </div>
            <h5 class="mt-3">Laura Torres</h5>
            <p class="text-muted">Lead Developer</p>
        </div>

        <div class="team-member">
            <div class="img-wrapper">
                <img src="@Url.Content("~/assets/img/team4.jpg")" class="team-img" alt="UX" />
                <div class="team-overlay"><span>UX</span></div>
            </div>
            <h5 class="mt-3">Marcos Ruiz</h5>
            <p class="text-muted">UX Designer</p>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta text-white text-center p-5 scroll-anim">
    <h2>¿Listo para transformar tu negocio?</h2>
    <a asp-page="/Landing2" class="btn btn-light mt-3">Ver sistema</a>
</section>

<footer class="text-center p-3" style="background:#1e1b4b; color:#a5b4fc;">
    © 2026 Nexus Software
</footer>


<style>

    /* ══════════════════════════════════════════
       ORDEN IMPORTA: las secciones con color
       deben declararse ANTES de cualquier regla
       que diga "background: transparent"
       ══════════════════════════════════════════ */

    body {
        background: linear-gradient(135deg, #c7d2fe, #e0e7ff, #ede9fe) !important;
        min-height: 100vh;
    }

    /* Transiciones solo en propiedades específicas
       (NO en "all", que interfiere con scroll-anim) */
    * {
        transition: color 0.25s ease, transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
    }

    /* ── ICONOS LUCIDE ── */
    i[data-lucide] {
        width: 22px;
        height: 22px;
        margin-right: 8px;
        stroke: currentColor;
    }

    /* ── HERO ── */
    .masthead {
        position: relative;
        background-attachment: fixed;
    }

  

    .masthead::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(37,99,235,0.7), rgba(124,58,237,0.7));
    }

    .masthead .container {
        position: relative;
        z-index: 2;
    }

    /* ── FONDOS DE SECCIONES ──
       !important necesario para ganarle a Bootstrap */
    .section-blue {
        background: linear-gradient(135deg, #1e3a8a, #2563EB) !important;
        color: white !important;
    }

    .section-purple {
        background: linear-gradient(135deg, #4c1d95, #7C3AED) !important;
        color: white !important;
    }

    .section-mix {
        background: linear-gradient(135deg, #1e1b4b, #312e81) !important;
        color: white !important;
    }

    .section-light {
        background: rgba(255, 255, 255, 0.55) !important;
        color: #0f172a !important;
    }

    .cta {
        background: linear-gradient(135deg, #2563EB, #7C3AED) !important;
    }

    /* ── RESULTADOS ── */
    .results-list {
        list-style: none;
        max-width: 500px;
        margin: auto;
        padding: 0;
    }

    .results-list li {
        margin: 15px 0;
        padding: 10px;
        border-left: 5px solid #A78BFA;
        color: white;
    }

    .counter {
        font-weight: bold;
        color: #A78BFA;
    }

    /* ── CARDS SERVICIOS ── */
    .grid-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .card-pro {
        position: relative;
        height: 250px;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
    }

    .card-pro:hover { transform: scale(1.05); }

    .card-bg {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .overlay {
        position: absolute;
        inset: 0;
        opacity: 0.7;
    }

    .overlay.blue   { background: #2563EB; }
    .overlay.purple { background: #7C3AED; }
    .overlay.dark   { background: #0F172A; }

    .card-content {
        position: absolute;
        bottom: 20px;
        left: 20px;
        color: white;
    }

    .card-content h4,
    .card-content p { color: white; margin: 0; }

    /* ── CASOS DE ÉXITO ── */
    .cases-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
    }

    .case-card {
        width: 100%;
        min-width: 300px;
        max-width: 500px;
        border-radius: 20px;
        cursor: pointer;
        overflow: hidden;
    }

    .case-card.blue   { background: linear-gradient(135deg, #2563EB, #3B82F6); }
    .case-card.purple { background: linear-gradient(135deg, #7C3AED, #A78BFA); }
    .case-card.dark   { background: linear-gradient(135deg, #0F172A, #334155); }

    .case-header {
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
    }

    .case-header i[data-lucide] { stroke: white; }

    .arrow {
        display: inline-block;
        transition: transform 0.3s ease !important;
    }

    .case-card.active .arrow { transform: rotate(180deg); }

    .case-body {
        background: white;
        color: #0f172a;
        max-height: 0;
        overflow: hidden;
        padding: 0 15px;
        transition: max-height 0.35s ease, padding 0.35s ease !important;
    }

    .case-card.active .case-body {
        max-height: 150px;
        padding: 15px;
    }

    /* ── EQUIPO ── */
    .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        margin-top: 30px;
    }

    .team-member {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .img-wrapper {
        position: relative;
        width: 170px;
        height: 170px;
        margin: auto;
    }

    .team-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        border-radius: 50%;
        border: 5px solid #7C3AED;
    }

    .team-overlay {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563EB, #7C3AED);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        transition: opacity 0.3s ease !important;
    }

    .img-wrapper:hover .team-overlay { opacity: 0.9; }

    /* ── SCROLL ANIMATION ──
       transition con !important para que "* { transition }" no la pise */
    .scroll-anim {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.6s ease, transform 0.6s ease !important;
    }

    .scroll-anim.show {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

</style>


@section Scripts {

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/pages/Index.js"></script>

    <script>
        // ── Íconos Lucide ──
        lucide.createIcons();

        // ── Acordeón casos de éxito ──
        document.querySelectorAll(".case-card").forEach(function (card) {
            card.addEventListener("click", function () {
                card.classList.toggle("active");
            });
        });

        // ── Scroll animations ──
        function checkScrollAnim() {
            document.querySelectorAll(".scroll-anim").forEach(function (el) {
                if (el.getBoundingClientRect().top < window.innerHeight - 80) {
                    el.classList.add("show");
                }
            });
        }

        // ── Parallax hero (solo desktop) ──
        function handleParallax() {
            if (window.innerWidth > 768) {
                var masthead = document.querySelector(".masthead");
                if (masthead) {
                    masthead.style.backgroundPositionY = (window.scrollY * 0.4) + "px";
                }
            }
        }

        window.addEventListener("scroll", function () {
            checkScrollAnim();
            handleParallax();
        });

        // CRÍTICO: disparar al cargar para elementos ya en pantalla
        checkScrollAnim();

        // ── Contadores animados ──
        // IntersectionObserver: solo arrancan cuando entran en pantalla
        var counterObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;

                var el = entry.target;
                var target = parseInt(el.dataset.target);
                var current = 0;
                var increment = target / 60;

                var timer = setInterval(function () {
                    current += increment;
                    if (current >= target) {
                        el.innerText = target;
                        clearInterval(timer);
                    } else {
                        el.innerText = Math.ceil(current);
                    }
                }, 30);

                counterObserver.unobserve(el); // Una sola vez
            });
        }, { threshold: 0.3 });

        document.querySelectorAll(".counter").forEach(function (c) {
            counterObserver.observe(c);
        });
    </script>

}