@{
    ViewData["Title"] = "Inicio";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Index.css" />

<div class="landing">

    <!-- HERO -->
    <section class="hero">
        <div class="container text-center">
            <h1>Sistema de Pago por Servicios Ambientales</h1>
            <p>Gestione fincas, evalúe propiedades y genere pagos de forma automatizada.</p>

            <div class="mt-4">
                <a href="/Acceso/Login" class="btn btn-success btn-lg">Iniciar sesión</a>
                <a href="/RegistroPropiedades" class="btn btn-outline-light btn-lg">Registrar finca</a>
            </div>
        </div>
    </section>

    <!-- BLOQUES -->
    <section class="container section">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2>Registro inteligente</h2>
                <p>Capture información de fincas de forma rápida, organizada y sin errores.</p>
            </div>
            <div class="col-md-6">
                <img src="~/assets/img/1.jpg" class="img-fluid rounded shadow">
            </div>
        </div>
    </section>

    <section class="container section">
        <div class="row align-items-center flex-md-row-reverse">
            <div class="col-md-6">
                <h2>Evaluación técnica</h2>
                <p>Ingenieros forestales analizan cada propiedad con criterios definidos.</p>
            </div>
            <div class="col-md-6">
                <img src="~/assets/img/2.jpg" class="img-fluid rounded shadow">
            </div>
        </div>
    </section>

    <!-- PROCESO -->
    <section class="section text-center bg-light">
        <h2>Proceso del sistema</h2>

        <div class="process mt-4">
            <div class="step">Registro</div>
            <div class="arrow">→</div>
            <div class="step">Evaluación</div>
            <div class="arrow">→</div>
            <div class="step">Automatización</div>
            <div class="arrow">→</div>
            <div class="step">Pago</div>
        </div>
    </section>

    <!-- FUNCIONALIDADES -->
    <section class="section container">
        <h2 class="text-center mb-4">Funcionalidades</h2>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="feature-card green">
                    <h5>Registro</h5>
                    <p>Ingreso rápido y validado.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="feature-card blue">
                    <h5>Evaluación</h5>
                    <p>Análisis profesional.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="feature-card purple">
                    <h5>Estados</h5>
                    <p>Seguimiento en tiempo real.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="feature-card orange">
                    <h5>Pagos</h5>
                    <p>Cálculo automático.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="section bg-light">
        <div class="container text-center">
            <h2>Beneficios</h2>

            <div class="row mt-4">
                <div class="col-md-3">
                    <div class="benefit-card">
                        <h5>Ahorro de tiempo</h5>
                        <p>Automatización total.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="benefit-card">
                        <h5>Precisión</h5>
                        <p>Menos errores.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="benefit-card">
                        <h5>Control</h5>
                        <p>Seguimiento completo.</p>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="benefit-card">
                        <h5>Escalabilidad</h5>
                        <p>Crecimiento sin límites.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta">
        <div class="container text-center">
            <h2>Transforme la gestión ambiental</h2>
            <p>Optimice procesos y reduzca errores con una sola plataforma.</p>

            <a href="/Acceso/Login" class="btn btn-light btn-lg mt-3">Comenzar ahora</a>
        </div>
    </section>

</div>

