@using Entities_DTOs
@{
    ViewData["Title"] = "Reportes Ingeniero";
}

<link rel="stylesheet" href="~/css/MisPropiedades.css" />

<div class="container mt-4">

    <h2 class="mb-4">Reportes del Ingeniero Forestal</h2>

    <!-- FILTROS -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            Filtros de Consulta
        </div>
        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">
                    <label>Provincia</label>
                    <select id="provincia" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Cantón</label>
                    <select id="canton" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Distrito</label>
                    <select id="distrito" class="form-control"></select>
                </div>

                <div class="col-md-3">
                    <label>Rango de Fechas</label>
                    <input type="date" id="desde" class="form-control" />
                    <input type="date" id="hasta" class="form-control mt-2" />
                </div>

                <div class="col-md-12 text-end">
                    <button class="btn btn-success" onclick="consultar()">Consultar</button>
                </div>

            </div>

        </div>
    </div>

    <!-- RESULTADOS -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            Evaluaciones Realizadas
        </div>
        <div class="card-body">

            <table class="table table-striped align-middle">

                <thead>
                    <tr>
                        <th>Finca</th>
                        <th>Fecha Evaluación</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody id="tablaReportes">
                </tbody>

            </table>

        </div>
    </div>

</div>

<script>

    // 🔥 CARGAR TODO AL INICIO
    window.onload = async () => {
        await cargarProvincias();
        await consultar(); // 🔥 carga reportes automáticamente
    };

    // 🔹 PROVINCIAS
    async function cargarProvincias() {
        try {
            const res = await fetch("https://localhost:7106/api/Propiedad/provincias");
            const data = await res.json();

            let select = document.getElementById("provincia");
            select.innerHTML = '<option value="">Seleccione</option>';

            data.forEach(p => {
                select.innerHTML += `<option value="${p}">${p}</option>`;
            });

        } catch (error) {
            console.error("Error provincias:", error);
        }
    }

    // 🔹 PROVINCIA → CANTÓN
        document.getElementById("provincia").addEventListener("change", async function () {

        const provincia = this.value;

        let canton = document.getElementById("canton");
        canton.innerHTML = '<option value="">Seleccione</option>';

        if (!provincia) return;

        const res = await fetch(`https://ecommerce-w-apehakegexd0bedr.eastus-01.azurewebsites.net/api/Propiedad/cantones/${encodeURIComponent(provincia)}`);
        const data = await res.json();

        data.forEach(c => {
            canton.innerHTML += `<option value="${c}">${c}</option>`;
        });

    });

    // 🔹 CANTÓN → DISTRITO
        document.getElementById("canton").addEventListener("change", async function () {

        const canton = this.value;

        let distrito = document.getElementById("distrito");
        distrito.innerHTML = '<option value="">Seleccione</option>';

        if (!canton) return;

        const res = await fetch(`https://ecommerce-w-apehakegexd0bedr.eastus-01.azurewebsites.net/api/Propiedad/distritos/${encodeURIComponent(canton)}`);
        const data = await res.json();

        data.forEach(d => {
            distrito.innerHTML += `<option value="${d}">${d}</option>`;
        });

    });

    // 🔥 CONSULTAR
       async function consultar() {

        const provincia = document.getElementById("provincia").value || "";
        const canton = document.getElementById("canton").value || "";
        const distrito = document.getElementById("distrito").value || "";

        const desde = document.getElementById("desde").value || "1900-01-01";
        const hasta = document.getElementById("hasta").value || "2100-01-01";

        try {
            const url = `https://ecommerce-w-apehakegexd0bedr.eastus-01.azurewebsites.net/api/Propiedad/reportes?provincia=${encodeURIComponent(provincia)}&canton=${encodeURIComponent(canton)}&distrito=${encodeURIComponent(distrito)}&desde=${desde}&hasta=${hasta}`;

            const res = await fetch(url);

            if (!res.ok) {
                console.error("Error HTTP:", res.status);
                return;
            }

            const data = await res.json();

            let tabla = document.getElementById("tablaReportes");
            tabla.innerHTML = "";

            if (!data || data.length === 0) {
                tabla.innerHTML = `<tr><td colspan="5" class="text-center">No hay resultados</td></tr>`;
                return;
            }

            data.forEach(r => {
                tabla.innerHTML += `
                    <tr>
                        <td>${r.nombreFinca}</td>
                        <td>${new Date(r.fecha).toLocaleDateString()}</td>
                        <td>
                            <span class="badge
                                ${r.estado === 'Aprobada' ? 'bg-success' :
                                  r.estado === 'Rechazada' ? 'bg-danger' : 'bg-warning'}">
                                ${r.estado}
                            </span>
                        </td>
                        <td>
                             <a href="/Home/Evaluacion/${r.propiedadId}" 
                                 class="btn btn-sm btn-outline-primary">
                                 Ver
                            </a>
                       </td>
                    </tr>
                `;
            });

        } catch (error) {
            console.error("Error reportes:", error);
        }
    }

</script>