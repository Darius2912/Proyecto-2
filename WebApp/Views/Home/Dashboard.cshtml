@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}



<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="~/css/Dashboard.css" />

<h1> Usuarios del sistema </h1>

<h1>Dashboard</h1>
<p>ID de usuario actual: <strong>@ViewBag.IdUsuario</strong></p>
<p>Tu Rol: <strong>@ViewBag.Rol</strong></p>
<div class="bs-docs-section">
    <div class="row">
        <legend>Listado</legend>
        <div class="col-lg-12">
            <table id="tblUsers" class="display" style="width:100%">
                <thead>
                    <tr>

                        <th>Cedula</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Correo</th>
                        <th>Telefono</th>
                        <th>Estado</th>
                        <th>Rol</th>

                    </tr>
                </thead>
            </table>
        </div>

    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="bs-compomemt">
                <form>
                    <fieldset>

                        <legend> Edicion</legend>
                        <div class="form-group">
                            <label for="txtCedula" class="form-label mt-4">ID</label>
                            <input id="txtCedula" readonly type="text" class="form-control"></input>
                        </div>
                        <div class="form-group">
                            <label for="txtName" class="form-label mt-4">Nombre</label>
                            <input id="txtName" type="text" class="form-control"></input>
                        </div>
                        <div class="form-group">
                            <label for="txtLastName" class="form-label mt-4">Apellido</label>
                            <input id="txtLastName" type="text" class="form-control"></input>
                        </div>
                        <div class="form-group">
                            <label for="txtTelefono" class="form-label mt-4">Telefono</label>
                            <input id="txtTelefono" type="text" class="form-control"></input>
                        </div>
                        <div class="form-group">
                            <label for="txtEmail" class="form-label mt-4">Email</label>
                            <input id="txtEmail" type="text" class="form-control"></input>
                        </div>
                        <div class="form-group">
                            <label for="txtEstado"  class="form-label mt-4">Estado</label>
                            <input id="txtEstado" readonly type="text" class="form-control"></input>
                        </div>

                        <div class="form-group">
                            <label for="txtRol" class="form-label mt-4">Rol del usuario</label>
                            <select id="txtRol" class="form-control">
                            <option value="1">Usuario</option>
                            <option value="2">Administrador</option>
                            <option value="3">Ingeniero</option>
                            <option value="0">Desactivar</option>
                            <select/>
                            </div>

                       
                    


                    </fieldset>


                </form>

            
                
                <button id="btnUpdate" class="btn btn-primary btn-xs" type="button">Actualizar</button>

                <button id="btnDelete" class="btn btn-primary btn-xs" type="button">Eliminar</button>




            </div>


        </div>

    </div>



</div>


<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- scripts -->
<script src="~/js/pages/controlActions.js"></script>
<script src="~/js/pages/usuarios.js"></script>

