@using Entities_DTOs
@model List<PropiedadDTO>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis Propiedades";
}

<link rel="stylesheet" href="~/css/MisPropiedades.css" />

<div class="container mt-4">

    <h2 class="mb-4">@ViewData["Title"]</h2>

    <!-- DASHBOARD -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Total de Fincas</h5>
                    <h3 class="text-success">
                        @(Model != null ? Model.Count() : 0)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Aprobadas</h5>
                    <h3 class="text-success">
                        @(Model != null ? Model.Count(p => p.Estado == "Aprobada") : 0)
                    </h3>
                </div>
            </div>
        </div>

        <!-- 🔥 CAMBIO: YA NO HAY EN EVALUACIÓN -->
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Pendientes</h5>
                    <h3 class="text-warning">
                        @(Model != null ? Model.Count(p => p.Estado == "Pendiente") : 0)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Rechazadas</h5>
                    <h3 class="text-danger">
                        @(Model != null ? Model.Count(p => p.Estado == "Rechazada") : 0)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="card shadow-sm">
        <div class="card-header header-table">
            Listado de Fincas
        </div>

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Ubicación</th>
                        <th>Hectáreas</th>
                        <th>Estado</th>
                        <th>Progreso</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.NombreFinca</td>
                                <td>@p.Ubicacion</td>
                                <td>@p.TamanoHectareas ha</td>

                                <!-- ESTADO -->
                                <td>
                                    @if (p.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (p.Estado == "Aprobada")
                                    {
                                        <span class="badge bg-success">Aprobada ✔</span>
                                    }
                                    else if (p.Estado == "Rechazada")
                                    {
                                        <span class="badge bg-danger">Rechazada</span>
                                    }
                                </td>

                                <!-- 🔥 PROGRESO DINÁMICO -->
                                <td>
                                    <div class="progress" style="height:6px;">
                                        <div class="progress-bar
                                            @(p.Estado == "Pendiente" ? "bg-warning" :
                                                                                           p.Estado == "Aprobada" ? "bg-success" :
                                                                                           "bg-danger")"
                                             style="width:
                                            @(p.Estado == "Pendiente" ? "50%" : "100%")">
                                        </div>
                                    </div>
                                </td>

                                <!-- FECHA -->
                                <td>@p.FechaRegistro.ToString("dd/MM/yyyy")</td>

                                <!-- 🔥 BOTÓN VER -->
                                <td>
                                    <a href="/Home/DetallePropiedad/@p.Id"
                                           class="btn btn-sm btn-outline-success">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No tienes propiedades registradas
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>