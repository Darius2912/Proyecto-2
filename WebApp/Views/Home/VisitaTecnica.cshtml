@using Entities_DTOs
@model List<PropiedadDTO>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Visitas Técnicas";
}

<link rel="stylesheet" href="~/css/MisPropiedades.css" />

<div class="container mt-4">

    <h2 class="mb-4">Cola de Evaluaciones</h2>

    <!-- DASHBOARD -->
    <div class="row mb-4">

        <!-- Pendientes -->
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Pendientes</h5>
                    <h3 class="text-warning">
                        @(Model != null ? Model.Count(p => p.Estado == "Pendiente") : 0)
                    </h3>
                </div>
            </div>
        </div>

        <!-- Aprobadas -->
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Aprobadas</h5>
                    <h3 class="text-success">
                        @(Model != null ? Model.Count(p => p.Estado == "Aprobada") : 0)
                    </h3>
                </div>
            </div>
        </div>

        <!-- Rechazadas -->
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5>Rechazadas</h5>
                    <h3 class="text-danger">
                        @(Model != null ? Model.Count(p => p.Estado == "Rechazada") : 0)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="card shadow-sm">
        <div class="card-header header-table">
            Propiedades Pendientes de Evaluación
        </div>

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Finca</th>
                        <th>Ubicación</th>
                        <th>Hectáreas</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any(p => p.Estado == "Pendiente"))
                    {
                        foreach (var p in Model.Where(p => p.Estado == "Pendiente"))
                        {
                            <tr>
                                <td>@p.NombreFinca</td>
                                <td>@p.Ubicacion</td>
                                <td>@p.TamanoHectareas ha</td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @p.Estado
                                    </span>
                                </td>
                                <td>
                                    <a href="/Home/Evaluar/@p.Id" class="btn btn-sm btn-outline-primary">
                                        Evaluar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                No hay propiedades pendientes
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header header-table">
            Historial de Cálculos de la Propiedad
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table id="tablaCalculos" class="table table-hover mb-0 align-middle text-center">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Precio Base (ha)</th>
                            <th>Monto por bosque</th>
                            <th>Monto por terreno</th>
                            <th>Monto por uso Hídrico</th>
                            <th>Estado</th>
                            <th>Total Pago</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody >
                        <!-- Se llena dinámicamente -->
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script src="~/js/pages/Evaluacion.js"></script>
<script src="~/js/pages/ControlActions.js"> </script>