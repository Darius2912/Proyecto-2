@{
    Layout = "_Layout";
    ViewData["Title"] = "Pagos";
}

<div class="container mt-4">

    <h2 class="mb-4">@ViewData["Title"]</h2>

    <!-- CONSULTA -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            Consultar Incentivo
        </div>

        <div class="card-body">

            <form asp-action="Consultar" asp-controller="Pagos" method="post">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Propiedad" class="form-label"></label>
                        <select asp-for="Propiedad" class="form-control" asp-items="ViewBag.Propiedades">
                            <option value="">Seleccione una propiedad</option>
                        </select>
                        <span asp-validation-for="Propiedad" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Mes" class="form-label"></label>
                        <select asp-for="Mes" class="form-control" asp-items="ViewBag.Meses">
                            <option value="">Seleccione un mes</option>
                        </select>
                        <span asp-validation-for="Mes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Ano" class="form-label"></label>
                        <select asp-for="Ano" class="form-control" asp-items="ViewBag.Anios">
                            <option value="">Seleccione un año</option>
                        </select>
                        <span asp-validation-for="Ano" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-success">Consultar</button>
                </div>
            </form>

        </div>
    </div>

    <!-- DETALLE -->
    @if (Model != null && Model.DetalleIncentivo != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                Detalle del Incentivo
            </div>

            <div class="card-body">

                <p><strong>Propiedad:</strong> @Model.DetalleIncentivo.Propiedad</p>
                <p><strong>Periodo:</strong> @Model.DetalleIncentivo.Mes @Model.DetalleIncentivo.Ano</p>

                <hr />

                <h5>Desglose del cálculo</h5>

                <ul>
                    <li>Pago base por hectárea: @Model.DetalleIncentivo.PagoBase.ToString("C0")</li>
                    <li>Vegetación: @Model.DetalleIncentivo.BonoVegetacion%</li>
                    <li>Recursos hídricos: @Model.DetalleIncentivo.BonoAgua%</li>
                    <li>Pendiente: @Model.DetalleIncentivo.BonoPendiente%</li>
                </ul>

                <h4 class="text-success">Monto a recibir: @Model.DetalleIncentivo.MontoTotal.ToString("C0")</h4>

                <div class="mt-3">
                    @if (Model.DetalleIncentivo.Estado == "Pagado")
                    {
                        <span class="badge bg-success">Pago realizado</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">En proceso</span>
                    }
                </div>

            </div>
        </div>
    }

    <!-- HISTORIAL -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            Historial de Incentivos
        </div>

        <div class="card-body">

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Propiedad</th>
                        <th>Periodo</th>
                        <th>Monto recibido</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Finca Los Pinos</td>
                        <td>Enero 2026</td>
                        <td>₡123,000</td>
                        <td><span class="badge bg-success">Pagado</span></td>
                    </tr>
                    <tr>
                        <td>Finca La Esperanza</td>
                        <td>Febrero 2026</td>
                        <td>₡110,000</td>
                        <td><span class="badge bg-warning text-dark">En proceso</span></td>
                    </tr>
                </tbody>

            </table>

        </div>
    </div>

</div>