@model WebApp.Models.PagosViewModel

@{
    ViewData["Title"] = "Pagos";
}

<div class="container mt-4">

    <h2 class="mb-4">Gestión de Pagos</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-warning">
            @Model.Mensaje
        </div>
    }

    <form method="post" asp-action="Pagos" asp-controller="Home">

        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                Consultar Pago
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <!-- PROPIEDAD -->
                    <div class="col-md-3">
                        <label>Propiedad</label>
                        <select asp-for="PropiedadSeleccionada" class="form-control">
                            <option value="Finca Los Pinos">Finca Los Pinos</option>
                            <option value="Finca La Esperanza">Finca La Esperanza</option>
                        </select>
                    </div>

                    <!-- AÑO -->
                    <div class="col-md-2">
                        <label>Año</label>
                        <select asp-for="AnioSeleccionado" class="form-control">
                            @for (int i = 2000; i <= DateTime.Now.Year + 5; i++)
                            {
                                <option value="@i" selected="@(i == DateTime.Now.Year)">
                                    @i
                                </option>
                            }
                        </select>
                    </div>

                    <!-- HECTÁREAS -->
                    <div class="col-md-2">
                        <label>Hectáreas</label>
                        <input asp-for="Hectareas" type="number" class="form-control" />
                    </div>

                    <!-- 🔥 PRECIO POR HECTÁREA (MEJORADO) -->
                    <div class="col-md-3">
                        <label>Precio por hectárea (₡)</label>
                        <select asp-for="PrecioPorHectarea" class="form-control">
                            <option value="300000">₡300,000 (Bajo)</option>
                            <option value="500000">₡500,000</option>
                            <option value="1000000">₡1,000,000</option>
                            <option value="2000000">₡2,000,000</option>
                            <option value="3000000">₡3,000,000</option>
                            <option value="5000000">₡5,000,000 (Alto)</option>
                        </select>
                    </div>

                    <!-- VEGETACIÓN -->
                    <div class="col-md-2">
                        <label>Vegetación</label>
                        <select asp-for="Vegetacion" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                            <option value="20">20%</option>
                        </select>
                    </div>

                    <!-- HIDRICOS -->
                    <div class="col-md-2">
                        <label>Recursos Hídricos</label>
                        <select asp-for="RecursosHidricos" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                    <!-- PENDIENTE -->
                    <div class="col-md-2">
                        <label>Pendiente</label>
                        <select asp-for="Pendiente" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-success">Calcular Pago</button>
                </div>

            </div>
        </div>

    </form>

    @if (Model.TotalPago > 0)
    {
        <div class="alert alert-success">
            Pago calculado correctamente
        </div>
    }

    @if (Model.PagoDetalle != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                Detalle del Pago
            </div>

            <div class="card-body">

                <p><strong>Propiedad:</strong> @Model.PagoDetalle.Propiedad</p>
                <p><strong>Periodo:</strong> @Model.PagoDetalle.Periodo</p>

                <p><strong>Factura:</strong> @Model.NumeroFactura</p>
                <p><strong>Fecha:</strong> @Model.FechaPago</p>

                <ul>
                    <li>Pago base: ₡@Model.PagoBase.ToString("N0")</li>
                    <li>Vegetación: @Model.Vegetacion %</li>
                    <li>Hídricos: @Model.RecursosHidricos %</li>
                    <li>Pendiente: @Model.Pendiente %</li>
                </ul>

                <h4 class="text-success">
                    Monto Total: ₡@Model.TotalPago.ToString("N0")
                </h4>

                <span class="badge bg-warning text-dark">
                    @Model.PagoDetalle.Estado
                </span>

            </div>
        </div>
    }

    <!-- PLAN DE PAGOS -->
    @if (Model.PlanPagos != null && Model.PlanPagos.Any())
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                Plan de Pagos (Anual)
            </div>

            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Monto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.PlanPagos)
                        {
                            <tr>
                                <td>@item.Periodo</td>
                                <td>₡@item.Monto.ToString("N0")</td>
                                <td>@item.Estado</td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

    <!-- AUDITORÍA -->
    @if (!string.IsNullOrEmpty(Model.Auditoria))
    {
        <div class="alert alert-info mt-3">
            @Model.Auditoria
        </div>
    }

</div>