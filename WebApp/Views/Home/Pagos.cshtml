@model WebApp.Models.PagosViewModel

@{
    ViewData["Title"] = "Pagos";
}

<div class="container mt-4">

    <h2 class="mb-4">Gestión de Pagos (Administrador)</h2>

    <!-- DASHBOARD -->
    <div class="row mb-4">

        <div class="col-md-6">
            <div class="card text-white bg-danger shadow">
                <div class="card-body text-center">
                    <h5>Total Deuda Acumulada</h5>
                    <h2>₡@Model.TotalDeuda.ToString("N0")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card text-dark bg-warning shadow">
                <div class="card-body text-center">
                    <h5>Fincas Pendientes</h5>
                    <h2>@Model.CantidadPendientes</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- GRÁFICO -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            Distribución de Deuda por Finca
        </div>
        <div class="card-body">
            <canvas id="graficoPagos" style="height:300px;"></canvas>
        </div>
    </div>

    <!-- FORM -->
    <form method="post" asp-action="Pagos" asp-controller="Home">

        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                Calcular Pago
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">
                        <label>Propiedad</label>
                        <select asp-for="PropiedadSeleccionada" class="form-control">
                            <option value="Finca Los Pinos">Finca Los Pinos</option>
                            <option value="Finca La Esperanza">Finca La Esperanza</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label>Mes</label>
                        <select asp-for="MesSeleccionado" class="form-control">
                            @foreach (var mes in System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames)
                            {
                                if (!string.IsNullOrEmpty(mes))
                                {
                                    <option value="@mes">@mes</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Año</label>
                        <select asp-for="AnioSeleccionado" class="form-control">
                            @for (int i = 2020; i <= DateTime.Now.Year + 5; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <!-- 🔥 HECTÁREAS CORREGIDO -->
                    <div class="col-md-2">
                        <label>Hectáreas</label>
                        <select asp-for="Hectareas" class="form-control">
                            @for (int i = 1; i <= 100; i++)
                            {
                                <option value="@i">@i ha</option>
                            }
                        </select>
                    </div>

                    <!-- PRECIO -->
                    <div class="col-md-2">
                        <label>Precio x Hectárea</label>
                        <select asp-for="PrecioPorHectarea" class="form-control">
                            <option value="500000">₡500,000</option>
                            <option value="1000000">₡1,000,000</option>
                            <option value="2000000">₡2,000,000</option>
                            <option value="3000000">₡3,000,000</option>
                            <option value="5000000">₡5,000,000</option>
                        </select>
                    </div>

                    <!-- PORCENTAJES -->
                    <div class="col-md-2">
                        <label>Vegetación</label>
                        <select asp-for="Vegetacion" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                            <option value="20">20%</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Hídricos</label>
                        <select asp-for="RecursosHidricos" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label>Pendiente</label>
                        <select asp-for="Pendiente" class="form-control">
                            <option value="0">0%</option>
                            <option value="5">5%</option>
                            <option value="10">10%</option>
                            <option value="15">15%</option>
                        </select>
                    </div>

                </div>

                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-success">Calcular</button>
                </div>

            </div>
        </div>

    </form>

    <!-- FACTURA -->
    @if (Model.PagoDetalle != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                Factura / Detalle
            </div>

            <div class="card-body">

                <p><strong>Factura:</strong> @Model.NumeroFactura</p>
                <p><strong>Fecha:</strong> @Model.FechaPago</p>
                <p><strong>Propiedad:</strong> @Model.PagoDetalle.Propiedad</p>
                <p><strong>Periodo:</strong> @Model.PagoDetalle.Periodo</p>

                <ul>
                    <li>Pago base: ₡@Model.PagoBase.ToString("N0")</li>
                    <li>Vegetación: @Model.Vegetacion %</li>
                    <li>Hídricos: @Model.RecursosHidricos %</li>
                    <li>Pendiente: @Model.Pendiente %</li>
                </ul>

                <h4 class="text-success">
                    Total: ₡@Model.TotalPago.ToString("N0")
                </h4>

            </div>
        </div>
    }

    <!-- HISTORIAL -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            Historial de Pagos
        </div>

        <div class="card-body">

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Propiedad</th>
                        <th>Periodo</th>
                        <th>Monto</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.HistorialFiltrado)
                    {
                        <tr>
                            <td>@item.Propiedad</td>
                            <td>@item.Periodo</td>
                            <td>₡@item.Monto.ToString("N0")</td>
                            <td>@item.Estado</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- SCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = [
        @foreach (var item in Model.FincasPendientes)
        {
                @: '@item.Propiedad',
        }
    ];

    const data = [
        @foreach (var item in Model.FincasPendientes)
        {
                @: @item.Monto,
        }
    ];

    new Chart(document.getElementById('graficoPagos'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Monto ₡',
                data: data,
                borderWidth: 1
            }]
        }
    });
</script>