@{
    ViewData["Title"] = "Reportes";
}

<div class="container mt-4">

    <h2 class="mb-4">Evaluación de Mis Fincas</h2>

    <!-- SELECCIÓN -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            Consultar Evaluación
        </div>

        <div class="card-body">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Propiedad</label>
                        <select class="form-control" name="PropiedadSeleccionada">
                            <!-- Opciones dinámicas desde el modelo -->
                        </select>
                    </div>

                    <div class="col-md-6 text-end align-self-end">
                        <button type="submit" class="btn btn-success">Consultar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- RESULTADO -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            Resultado de Evaluación
        </div>

        <div class="card-body">
            <p>
                <strong>Estado:</strong>
                <span class="badge"> <!-- Estado dinámico --> </span>
            </p>

            <p><strong>Fecha de evaluación:</strong> <!-- Fecha dinámica --> </p>

            <hr />

            <h5>Observaciones del Ingeniero</h5>
            <p><!-- Observaciones dinámicas --></p>

            <hr />

            <h5>Cambios realizados</h5>
            <ul>
                <!-- Lista dinámica de cambios -->
            </ul>
        </div>
    </div>

    <!-- HISTORIAL -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            Historial de Evaluaciones
        </div>

        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Filas dinámicas del historial -->
                </tbody>
            </table>
        </div>
    </div>

</div>