@using Entities_DTOs
@model PropiedadDTO

@{
    Layout = "_Layout";
    ViewData["Title"] = "Evaluación de Finca";
}

<link rel="stylesheet" href="~/css/MisPropiedades.css" />

<div class="container mt-4">

    <a href="/Home/VisitaTecnica" class="btn btn-outline-secondary mb-3">
        ← Volver a la cola
    </a>

    <h2 class="mb-4">Evaluación Técnica</h2>

    <!-- INFO FINCA -->
    <div class="card shadow-sm mb-4">
        <div class="card-header header-table">
            Información de la Finca
        </div>

        <div class="card-body">

            <h4 class="mb-3">@Model.NombreFinca</h4>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Hectáreas</label>
                    <input type="number" id="tamano" class="form-control"
                           value="@Model.TamanoHectareas">
                </div>

                <div class="col-md-6">
                    <label class="fw-bold">Ubicación</label>
                    <input type="text" class="form-control bg-light"
                           value="@Model.Ubicacion" readonly>
                </div>
            </div>

            <!-- 🔥 CAMPOS -->
            <h5 class="mt-4">Características Ambientales</h5>

            <div class="row">

                <!-- Tipo superficie -->
                <div class="col-md-4 mb-3">
                    <label>Tipo de superficie</label>
                    <select id="tipoSuperficie" class="form-control">
                        <option value="Plana">Plana</option>
                        <option value="Inclinada">Inclinada</option>
                        <option value="Muy inclinada" >Muy inclinada</option>
                    </select>
                </div>

                <!-- Ríos -->
                <div class="col-md-4 mb-3">
                    <label>¿Tiene ríos?</label>
                    <select id="rios" class="form-control">
                        <option value="true" selected="@(Model.TieneRio ? "selected" : null)">Sí</option>
                        <option value="false" selected="@(!Model.TieneRio ? "selected" : null)">No</option>
                    </select>
                </div>

                <!-- Nacientes -->
                <div class="col-md-4 mb-3">
                    <label>¿Posee nacientes?</label>
                    <select id="nacientes" class="form-control">
                        <option value="true" selected="@(Model.Nacientes ? "selected" : null)">Sí</option>
                        <option value="false" selected="@(!Model.Nacientes ? "selected" : null)">No</option>
                    </select>
                </div>

                <!-- Cantidad -->
                <div class="col-md-4 mb-3">
                    <label>Cantidad de nacientes</label>
                    <input type="number" id="cantidadNacientes"
                           value="@Model.CantidadNacientes" class="form-control">
                </div>

                <!-- Vegetación -->
                <div class="col-md-4 mb-3">
                    <label>Tipo de Vegetación</label>
                    <select id="vegetacion" class="form-control">
                        <option value="Bosque" >Bosque primario</option>
                        <option value="Pastizal">Bosque secundario</option>
                        <option value="Cultivo" >Plantación forestal</option>
                        <option value="Mixto">Pasto</option>
                    </select>
                </div>
                <!-- Uso suelo -->
                <div class="col-md-4 mb-3">
                    <label>Uso de Suelo</label>
                    <select id="usoSuelo" class="form-control">
                        <option value="Agrícola" selected="@(Model.UsoSuelo == "Conservación" ? "selected" : null)">Conservación</option>
                        <option value="Ganadero" selected="@(Model.UsoSuelo == "Producción Forestal" ? "selected" : null)">Producción Forestal</option>
                        <option value="Forestal" selected="@(Model.UsoSuelo == "Agroforestal" ? "selected" : null)">Agroforestal</option>
                        <option value="Agroforestal" selected="@(Model.UsoSuelo == "Ganadería" ? "selected" : null)">Ganadería</option>
                        <option value="Agroforestal" selected="@(Model.UsoSuelo == "Mixto" ? "selected" : null)">Mixto</option>
                    </select>
                </div>

            </div>

            <!-- FOTOS -->
            <h5 class="mt-4">Fotografías</h5>

            <div class="row">
                @if (Model.Fotos != null && Model.Fotos.Count > 0)
                {
                    foreach (var foto in Model.Fotos)
                    {
                        <div class="col-md-3 mb-3">
                            <img src="@($"https://localhost:7106{foto}")"
                                 class="img-fluid rounded shadow"
                                 onclick="window.open('@($"https://localhost:7106{foto}")')" />
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No hay fotos</p>
                }
            </div>

        </div>
    </div>

    <!-- RESULTADO -->
    <div class="card shadow-sm">
        <div class="card-header header-table">
            Resultado de Evaluación
        </div>

        <div class="card-body">

            <select id="estado" class="form-control mb-3">
                <option value="">Seleccione...</option>
                <option value="Aprobada">Aprobada</option>
                <option value="Rechazada">Rechazada</option>
            </select>

            <textarea id="observaciones" class="form-control" rows="4"></textarea>

        </div>
    </div>

    <div class="text-end mt-4">
        <button class="btn btn-primary" onclick="finalizarEvaluacion(@Model.Id)">
            Finalizar Evaluación
        </button>
    </div>

</div>

<script>
    // 🔥 FUNCIÓN PARA CONTROLAR NACIENTES
    function toggleNacientes() {
        const tiene = document.getElementById("nacientes").value === "true";
        const input = document.getElementById("cantidadNacientes");

        if (!tiene) {
            input.value = 0;
            input.disabled = true;
        } else {
            input.disabled = false;
        }
    }

    // 🔥 CUANDO CARGA LA PÁGINA
    document.addEventListener("DOMContentLoaded", function () {
        toggleNacientes(); // ejecuta al inicio
        document.getElementById("nacientes").addEventListener("change", toggleNacientes);
    });

    // 🔥 TU FUNCIÓN ORIGINAL (NO SE TOCA)
    async function finalizarEvaluacion(id) {

        const data = {
            propiedadId: id,
            estado: document.getElementById("estado").value,
            observaciones: document.getElementById("observaciones").value,
            idUsuario: @ViewBag.IdUsuario,

            tamanoHectareas: parseFloat(document.getElementById("tamano").value),
            tipoSuperficie: document.getElementById("tipoSuperficie").value,
            tieneRio: document.getElementById("rios").value === "true",
            nacientes: document.getElementById("nacientes").value === "true",
            cantidadNacientes: parseInt(document.getElementById("cantidadNacientes").value) || 0,
            tipoVegetacion: document.getElementById("vegetacion").value,
            usoSuelo: document.getElementById("usoSuelo").value
        };

        try {
            const response = await fetch("https://localhost:7106/api/Propiedad/evaluar", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                alert("✅ Evaluación guardada correctamente");
                window.location.href = "/Home/VisitaTecnica";
            } else {
                alert("❌ Error al guardar la evaluación");
            }

        } catch (error) {
            console.error(error);
            alert("❌ Error de conexión");
        }
    }
</script>